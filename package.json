{
  "name": "pulseops",
  "version": "0.1.0",
  "private": true,
  "description": "Small HTTP monitoring platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
