    # PostgreSQL container and application connection
    POSTGRES_DB=pulseops
    POSTGRES_USER=pulseops
    POSTGRES_PASSWORD=pulseops
    DATABASE_URL=postgresql://pulseops:pulseops@localhost:5432/pulseops

    # API and worker settings
    PORT=8080
    CHECK_INTERVAL_MS=30000
    REQUEST_TIMEOUT_MS=5000
ALLOWED_HOSTS=example.com,api
